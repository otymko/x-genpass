#требуется ГенерацияПаролей.sbsl
#требуется КонсольноеПриложение.sbsl

конст ИМЯ_ПРИЛОЖЕНИЯ = "x-genpass"
конст ВЕРСИЯ_ПРИЛОЖЕНИЯ = Версия{0.1}
конст ОПИСАНИЕ_ПРИЛОЖЕНИЯ = "Простой генератор паролей на `1С: Исполнитель`"

конст СЛУЖЕБНОЕ_X_EMPTY_ARGS = "X_EMPTY_ARGS"

конст ДЛИНА_ПАРОЛЯ_ПО_УМОЛЧАНИЮ = 32

перечисление ФлагиПриложения
    ВЕРСИЯ,
    СПРАВКА,
    ВКЛЮЧАТЬ_НИЖНИЙ_РЕГИСТР,
    ВКЛЮЧАТЬ_ЦИФРЫ,
    ВКЛЮЧАТЬ_СПЕЦИАЛЬНЫЕ_СИМВОЛЫ
;

конст ФЛАГ_СПРАВКА = "h"
конст ФЛАГ_СПРАВКА_ПОЛНАЯ = "help"

конст ФЛАГ_ВЕРСИЯ = "v"
конст ФЛАГ_ВЕРСИЯ_ПОЛНАЯ = "version"

конст ФЛАГ_ВКЛЮЧАТЬ_НИЖНИЙ_РЕГИСТР = "l"
конст ФЛАГ_ВКЛЮЧАТЬ_НИЖНИЙ_РЕГИСТР_ПОЛНАЯ = "include-lowercase"

конст ФЛАГ_ВКЛЮЧАТЬ_ЦИФРЫ = "n"
конст ФЛАГ_ВКЛЮЧАТЬ_ЦИФРЫ_ПОЛНАЯ = "include-numeric"

конст ФЛАГ_ВКЛЮЧАТЬ_СПЕЦИАЛЬНЫЕ_СИМВОЛЫ = "s"
конст ФЛАГ_ВКЛЮЧАТЬ_СПЕЦИАЛЬНЫЕ_СИМВОЛЫ_ПОЛНАЯ = "include-special"

метод Скрипт(ПараметрыКоманднойСтроки: Массив<Строка>)
    пер Контекст: КонсольноеПриложение.КонтекстСкрипта?
    попытка
        Контекст = ИнициализироватьКонтекстСкрипта(ПараметрыКоманднойСтроки)
    поймать Е: КонсольноеПриложение.ОшибкаРазбораАргументовКоманднойСтроки
        Консоль.Записать("ОШИБКА: " + Е.Описание)
        Скрипт.ЗавершитьРаботу(1)
    поймать Е: Исключение
        Консоль.Записать("ОШИБКА: " + "Неизвестная ошибка приложения")
        Скрипт.ЗавершитьРаботу(1)    
    ;

    ЗапуститьПриложение(Контекст!)
;

метод ЗапуститьПриложение(Контекст: КонсольноеПриложение.КонтекстСкрипта)
    если Контекст.ВывестиСправку
        ВывестиВКонсольСправку(Контекст)
        
        возврат
    ;

    если Контекст.ВывестиВерсию
        Консоль.Записать(ВЕРСИЯ_ПРИЛОЖЕНИЯ)
        возврат
    ;

    знч СгенерированныйПароль = ГенерацияПаролей.СгенерироватьПароль(Контекст.НастройкиГенерации)
    Консоль.Записать(СгенерированныйПароль)
;

метод ИнициализироватьКонтекстСкрипта(ПараметрыКоманднойСтроки: Массив<Строка>): КонсольноеПриложение.КонтекстСкрипта
    пер Контекст = новый КонсольноеПриложение.КонтекстСкрипта()

    если ПараметрыКоманднойСтроки.Найти(СЛУЖЕБНОЕ_X_EMPTY_ARGS) != Неопределено
        ПараметрыКоманднойСтроки.Удалить(СЛУЖЕБНОЕ_X_EMPTY_ARGS)
    ;

    для ПараметрКоманднойСтроки из ПараметрыКоманднойСтроки
        если ПараметрКоманднойСтроки.НачинаетсяС("-")
            Контекст.Флаги.Добавить(ПараметрКоманднойСтроки)
        иначе
            Контекст.Аргументы.Добавить(ПараметрКоманднойСтроки)
        ;
    ;

    если Контекст.Аргументы.Размер() > 1 
        выбросить новый КонсольноеПриложение.ОшибкаРазбораАргументовКоманднойСтроки(
            "Передано больше 1 аргумента командой строки.")
    ;

    ЗаполнитьВозможныеФлагиПриложения(Контекст)
    КонсольноеПриложение.ПроверитьФлагиНаСуществование(Контекст)

    если Контекст.Аргументы.Пусто()
        Контекст.НастройкиГенерации.ДлинаПароля = ДЛИНА_ПАРОЛЯ_ПО_УМОЛЧАНИЮ
    иначе
        пер ДлинаПароля: Число
        попытка 
            ДлинаПароля = новый Число(Контекст.Аргументы[0])
        поймать Исключение: Исключение
            выбросить новый КонсольноеПриложение.ОшибкаРазбораАргументовКоманднойСтроки(Исключение.Описание)
        ;
        Контекст.НастройкиГенерации.ДлинаПароля = ДлинаПароля
    ;

    Контекст.ВывестиВерсию = КонсольноеПриложение.ФлагУстановлен(
        // FIXME .ВСтроку() не очень хороший вариант, тут бы наследование
        Контекст.Флаги, Контекст.ДоступныеФлагиПриложения[ФлагиПриложения.ВЕРСИЯ.ВСтроку()])
    Контекст.ВывестиСправку = КонсольноеПриложение.ФлагУстановлен(
        Контекст.Флаги, Контекст.ДоступныеФлагиПриложения[ФлагиПриложения.СПРАВКА.ВСтроку()])

    Контекст.НастройкиГенерации.НижнийРегистр = КонсольноеПриложение.ФлагУстановлен(
        Контекст.Флаги, Контекст.ДоступныеФлагиПриложения[ФлагиПриложения.ВКЛЮЧАТЬ_НИЖНИЙ_РЕГИСТР.ВСтроку()])

    Контекст.НастройкиГенерации.СпециальныеСимволы = КонсольноеПриложение.ФлагУстановлен(
        Контекст.Флаги, Контекст.ДоступныеФлагиПриложения[ФлагиПриложения.ВКЛЮЧАТЬ_СПЕЦИАЛЬНЫЕ_СИМВОЛЫ.ВСтроку()])

    Контекст.НастройкиГенерации.Цифры = КонсольноеПриложение.ФлагУстановлен(
        Контекст.Флаги, Контекст.ДоступныеФлагиПриложения[ФлагиПриложения.ВКЛЮЧАТЬ_ЦИФРЫ.ВСтроку()])

    возврат Контекст
;

метод ЗаполнитьВозможныеФлагиПриложения(Контекст: КонсольноеПриложение.КонтекстСкрипта)
    знч ФлагВерсия = новый КонсольноеПриложение.ОписаниеФлагаПриложения(
        ФлагиПриложения.ВЕРСИЯ.ВСтроку(), 
        ФЛАГ_ВЕРСИЯ_ПОЛНАЯ, 
        ФЛАГ_ВЕРСИЯ, 
        "версия приложения")
    Контекст.ДоступныеФлагиПриложения.Вставить(ФлагиПриложения.ВЕРСИЯ.ВСтроку(), ФлагВерсия)

    знч ФлагСправка = новый КонсольноеПриложение.ОписаниеФлагаПриложения(
        ФлагиПриложения.СПРАВКА.ВСтроку(),
        ФЛАГ_СПРАВКА_ПОЛНАЯ, 
        ФЛАГ_СПРАВКА, 
        "вывести справку")
    Контекст.ДоступныеФлагиПриложения.Вставить(ФлагиПриложения.СПРАВКА.ВСтроку(), ФлагСправка)

    знч ФлагНижнийРегистр = новый КонсольноеПриложение.ОписаниеФлагаПриложения(
        ФлагиПриложения.ВКЛЮЧАТЬ_НИЖНИЙ_РЕГИСТР.ВСтроку(),
        ФЛАГ_ВКЛЮЧАТЬ_НИЖНИЙ_РЕГИСТР_ПОЛНАЯ, 
        ФЛАГ_ВКЛЮЧАТЬ_НИЖНИЙ_РЕГИСТР, 
        "сгенерировать пароль, используя символы в нижнем регистре")
    Контекст.ДоступныеФлагиПриложения.Вставить(
        ФлагиПриложения.ВКЛЮЧАТЬ_НИЖНИЙ_РЕГИСТР.ВСтроку(), 
        ФлагНижнийРегистр)

    знч ФлагЦифры = новый КонсольноеПриложение.ОписаниеФлагаПриложения(
        ФлагиПриложения.ВКЛЮЧАТЬ_ЦИФРЫ.ВСтроку(),
        ФЛАГ_ВКЛЮЧАТЬ_ЦИФРЫ_ПОЛНАЯ, 
        ФЛАГ_ВКЛЮЧАТЬ_ЦИФРЫ, 
        "сгенерировать пароль, используя цифры")
    Контекст.ДоступныеФлагиПриложения.Вставить(
        ФлагиПриложения.ВКЛЮЧАТЬ_ЦИФРЫ.ВСтроку(), 
        ФлагЦифры)

    знч ФлагСпецСимволы = новый КонсольноеПриложение.ОписаниеФлагаПриложения(
        ФлагиПриложения.ВКЛЮЧАТЬ_СПЕЦИАЛЬНЫЕ_СИМВОЛЫ.ВСтроку(),
        ФЛАГ_ВКЛЮЧАТЬ_СПЕЦИАЛЬНЫЕ_СИМВОЛЫ_ПОЛНАЯ, 
        ФЛАГ_ВКЛЮЧАТЬ_СПЕЦИАЛЬНЫЕ_СИМВОЛЫ, 
        "сгенерировать пароль, используя спец символы: %ГенерацияПаролей.АЛФАВИТ_СПЕЦИАЛЬНЫЕ_СИМВОЛЫ")
    Контекст.ДоступныеФлагиПриложения.Вставить(
        ФлагиПриложения.ВКЛЮЧАТЬ_СПЕЦИАЛЬНЫЕ_СИМВОЛЫ.ВСтроку(), 
        ФлагСпецСимволы)
;

метод ВывестиВКонсольСправку(Контекст: КонсольноеПриложение.КонтекстСкрипта)
    знч ОТСТУП = "    "
    знч ИМЯ_АРГУМЕНТА_ДЛИНА_ПАРОЛЯ = "длина-пароля"
    знч МаксимальнаяДлинаИменФлагов = КонсольноеПриложение.МаксимальнаяДлинаИменФлагов(Контекст.ДоступныеФлагиПриложения)

    Консоль.Записать("")
    Консоль.Записать("Приложение: " + ИМЯ_ПРИЛОЖЕНИЯ)
    Консоль.Записать(ОПИСАНИЕ_ПРИЛОЖЕНИЯ)
    Консоль.Записать("")

    Консоль.Записать("ИСПОЛЬЗОВАНИЕ:")
    Консоль.Записать("%ОТСТУП x-genpass [ФЛАГИ] [%ИМЯ_АРГУМЕНТА_ДЛИНА_ПАРОЛЯ]")
    Консоль.Записать("")

    Консоль.Записать("ФЛАГИ:")
    для КлючЗначениеФлага из Контекст.ДоступныеФлагиПриложения

        знч ИменаФлага = КонсольноеПриложение.ПредставлениеИменФлага(КлючЗначениеФлага.Значение)
        знч ТекущийОтступДоМаксимумаИмен = МаксимальнаяДлинаИменФлагов - ИменаФлага.Длина()

        пер Строка = "%ОТСТУП " 
            + ИменаФлага + Строки.Повторить(" ", ТекущийОтступДоМаксимумаИмен)
            + "%ОТСТУП" + КлючЗначениеФлага.Значение.Описание 
        Консоль.Записать(Строка)
    ;

    Консоль.Записать("")
    Консоль.Записать("АРГУМЕНТЫ:")
    Консоль.Записать("%ОТСТУП <%ИМЯ_АРГУМЕНТА_ДЛИНА_ПАРОЛЯ>%ОТСТУП длина сгенерированного пароля [по умолчанию: %ДЛИНА_ПАРОЛЯ_ПО_УМОЛЧАНИЮ]")
;
